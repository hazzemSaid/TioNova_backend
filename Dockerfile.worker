FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install dependencies
RUN npm ci --only=production

# Copy source code
COPY src/ ./src/
COPY api/ ./api/

# Build TypeScript
RUN npm install -g typescript ts-node
RUN npm run build || tsc

# Run worker
CMD ["node", "-r", "ts-node/register", "src/workers/chapterWorker.ts"]
