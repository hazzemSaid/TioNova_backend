{
  "name": "tionova",
  "version": "1.0.0",
  "main": "api/index.ts",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node src/app.ts",
    "dev:watch": "nodemon --watch src --ext ts --exec \"ts-node\" src/app.ts",
    "worker": "ts-node src/workers/chapterWorker.ts",
    "start:all": "concurrently \"npm run dev\" \"npm run worker\"",
    "start:worker": "ts-node api/worker.ts",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.67.0",
    "@upstash/redis": "^1.35.5",
    "axios": "^1.8.4",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.61.0",
    "canvas": "^3.1.0",
    "cloudinary": "^2.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "dotenv-cli": "^8.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.5.0",
    "fs-extra": "^11.3.1",
    "fuse.js": "^7.1.0",
    "google-auth-library": "^9.15.1",
    "ioredis": "^5.8.1",
    "jsonrepair": "^3.9.0",
    "jsonwebtoken": "^9.0.2",
    "mailersend": "^2.5.0",
    "mailtrap": "^4.0.0",
    "mongodb": "^6.15.0",
    "mongoose": "^8.13.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.10.1",
    "nsfwjs": "^4.2.1",
    "qrcode": "^1.5.4",
    "redis": "^5.8.3",
    "resend": "^4.7.0",
    "rimraf": "^6.0.1",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vercel/node": "^5.3.22",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
